<Window x:Class="KantanPdfSplitter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="かんたんPDF分割" Width="900" Height="720" MinWidth="640" MinHeight="480" Icon="Assets/app.ico" WindowStartupLocation="CenterScreen" Background="#F3F6F8" Foreground="#17324D" UseLayoutRounding="True" Closing="Window_Closing">
  <Grid Background="#F3F6F8">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="InputScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid Margin="28,18,28,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="かんたんPDF分割" FontSize="30" FontWeight="Bold"/><TextBlock Text="ページを分けて、必要なPDFをかんたんに。" Foreground="#53687B" Margin="0,4,0,0"/></StackPanel>
        <Image Grid.Column="1" Source="Assets/logo.png" Width="180" Height="60" Stretch="Uniform" Margin="16,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="名古屋テクノロジー"/>
      </Grid>
      <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#D6DFE7" BorderThickness="1" Padding="22,18">
        <StackPanel>
          <StackPanel x:Name="InputPanel">
            <Button x:Name="DropArea" MinHeight="90" Background="#F2F7FC" BorderBrush="#6D94B8" BorderThickness="2" AllowDrop="True" Click="ChoosePdf_Click" DragOver="Pdf_DragOver" Drop="Pdf_Drop" AutomationProperties.Name="PDFを選ぶ" TabIndex="0">
              <StackPanel><TextBlock Text="PDFをここにドラッグしてください" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#245A8D"/><TextBlock Text="クリックして選ぶこともできます" Foreground="#53687B" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
            </Button>
            <TextBlock x:Name="FileSummary" Text="PDFが選択されていません" Margin="0,8,0,12" TextTrimming="CharacterEllipsis" ToolTip="選択したPDF"/>
            <TextBlock Text="分割方法" Style="{StaticResource Section}"/>
            <WrapPanel><RadioButton x:Name="EveryPage" Content="1ページずつ分ける" IsChecked="True" Checked="PlanChanged" GroupName="Mode" TabIndex="1"/><RadioButton x:Name="AtPages" Content="指定ページの後で分ける" Checked="PlanChanged" GroupName="Mode" TabIndex="2"/></WrapPanel>
            <StackPanel x:Name="CutsPanel" Visibility="Collapsed" Margin="0,6,0,0">
              <TextBox x:Name="CutsBox" TextChanged="PlanChanged" AutomationProperties.Name="分割するページ番号" TabIndex="3"/>
              <TextBlock Text="例：5,12 → 5ページ・12ページの直後で分割" FontSize="14" Foreground="#53687B" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="PreviewTitle" Text="分割結果のプレビュー" Style="{StaticResource Section}" Margin="0,12,0,6"/>
            <Border BorderBrush="#D6DFE7" BorderThickness="1" CornerRadius="5">
              <ListBox x:Name="PreviewList" Height="105" HorizontalContentAlignment="Stretch" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="出力ファイルとページ範囲" TabIndex="4">
                <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/><TextBlock Grid.Column="1" Text="{Binding Description}" Margin="16,0,0,0" Foreground="#53687B"/></Grid></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <Border x:Name="CompatibilityPanel" Visibility="Collapsed" Background="#FFF7E5" BorderBrush="#B58C36" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="分割前にご確認ください" FontWeight="SemiBold"/>
                <TextBlock x:Name="CompatibilityText" TextWrapping="Wrap" Margin="0,6,0,8" Foreground="#6D521C"/>
                <CheckBox x:Name="CompatibilityAcknowledgment" Content="上記の変更内容を確認しました" Checked="WarningsAcknowledged" Unchecked="WarningsAcknowledged" AutomationProperties.Name="分割に伴う変更内容の確認"/>
              </StackPanel>
            </Border>
            <TextBlock Text="保存先フォルダー" Style="{StaticResource Section}" Margin="0,12,0,6"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DestinationBox" IsReadOnly="True" AutomationProperties.Name="保存先フォルダー" TabIndex="5"/><Button Grid.Column="1" Content="選ぶ…" Click="ChooseFolder_Click" Margin="10,0,0,0" TabIndex="6"/></Grid>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
  <Border Grid.Row="1" Background="White" BorderBrush="#D6DFE7" BorderThickness="0,1,0,0" Padding="28,12,28,14">
    <StackPanel>
      <Button x:Name="SplitButton" Content="PDFを分割する" Height="52" Background="#245A8D" Foreground="White" BorderBrush="#174B73" FontSize="20" FontWeight="SemiBold" Click="Split_Click" IsEnabled="False" TabIndex="7"/>
      <ProgressBar x:Name="Progress" Visibility="Collapsed" Height="6" Margin="0,10,0,0"/>
      <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="元のPDFは変更されません。" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="OpenFolderButton" Grid.Column="1" Content="保存先を開く" Visibility="Collapsed" Click="OpenFolder_Click" Margin="12,0,0,0" TabIndex="8"/>
      </Grid>
    </StackPanel>
  </Border>
  </Grid>
</Window>
